// Configurazione Cloudflare del sito Il Contribuente (Mario, 23/11/2026; aggiornata 27/11/2026).
// Attiva la pagina 404.html per gli indirizzi sbagliati e, con worker/index.js,
// porta il vecchio indirizzo workers.dev e www su https://ilcontribuente.com (redirect 301).
// Non modificare: un errore qui può bloccare la pubblicazione del sito.
{
  "name": "ilcontribuente",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "not_found_handling": "404-page",
    "run_worker_first": true
  }
}
